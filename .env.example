# Supabase (local dev values come from `supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. NEVER reference from client components.
SUPABASE_SERVICE_ROLE_KEY=

# Provider mode: "mock" until Foundation/Shared Engine phases are proven end-to-end
WHATSAPP_PROVIDER=mock
INSTAGRAM_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Real credentials — added only when moving off mock providers, per business rule #6
INTERAKT_API_KEY=
INTERAKT_WEBHOOK_SECRET=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cron-invoked internal routes: shared secret so pg_net calls can be verified as internal
CRON_INTERNAL_SECRET=

# Rate limiting (lib/rate-limit/factory.ts): omit both to use the in-memory limiter
# (local dev only -- does not share state across serverless instances). Set both to switch
# to the real Upstash-backed limiter, required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
